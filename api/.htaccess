# Only the form endpoint is reachable from the web.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
  <Files "lead.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
  <Files "lead.php">
    Order deny,allow
    Allow from all
  </Files>
</IfModule>
