rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pricing plans shown on the public website.
    match /pricingPlans/{planId} {

      // Anyone can READ the plans (the public site needs this).
      allow read: if true;

      // Only your signed-in editors can CREATE / UPDATE / DELETE.
      // 👉 Replace these with the real editor emails you create in
      //    Firebase Authentication (Step 3 of the setup guide).
      allow write: if request.auth != null
        && request.auth.token.email in [
             "admin_prices@solidreachco.com"
           ];
    }

    // Everything else: locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
